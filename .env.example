# Copy this file to .env and provide your local trading backend's execution key.
# Never commit the populated .env file.
TRADING_API_BASE_URL=http://127.0.0.1:8000/api/v1/ai
TRADING_API_KEY=

# Six market-data capabilities run inside this repository. Select independently
# of EXECUTION_BROKER. CLI --market-data-broker takes precedence.
MARKET_DATA_BROKER=kite
MARKET_DATA_TIMEOUT_SEC=30
# REST authentication is independent of streaming. connect uses the existing
# KITE_API_KEY/KITE_ACCESS_TOKEN entitlement; web uses KITE_ENCTOKEN.
MARKET_DATA_TRANSPORT=web
# off = REST; web = existing Kite web session; connect = existing Connect entitlement.
# No automatic transport fallback or subscription purchase. Breeze retains native REST.
MARKET_DATA_STREAMING=off
# Optional current-day Zerodha NFO instrument CSV inside this workspace.
# Otherwise the provider downloads the public master once per process/session.
MARKET_INSTRUMENTS_FILE=

# Existing Kite web login session for zero-paid-API market ingestion.
# Daily session renewal is manual; an expired/missing session blocks entries.
KITE_ENCTOKEN=

# Optional credentials for local Kite account diagnostics.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
KITE_ACCOUNT_ID=

# Native ICICI Breeze. API_SESSION is the login API_Session value, not the
# signed session_token returned by the customer-details endpoint.
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_API_SESSION=
BREEZE_ACCOUNT_ID=
